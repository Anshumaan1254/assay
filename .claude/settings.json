{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python scripts/guard_core.py $CLAUDE_FILE_PATHS"
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python -m pytest -q --timeout=120"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "git log --oneline -5 && tail -20 DECISIONS.md"
                    }
                ]
            }
        ]
    }
}