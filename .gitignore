.env
.env.local
__pycache__/
*.py[cod]
venv/
.venv/
conda-env/
.pytest_cache/
.coverage
.vscode/

# datagen output is deterministic (same seed -> byte-identical) and
# regenerable via `python -m datagen.cli --profile ... --seed ...`, so
# ad-hoc runs aren't committed. The one canonical realistic-profile demo
# run is force-added past this ignore -- see DECISIONS.md.
runs/

# store/'s default checkpoint/journal database -- local runtime state,
# regenerated fresh (ASSAY_STORE_PATH overrides this in every test).
.assay/

# chaos/incident.py's structured incident log -- regenerated by every
# `make chaos` run, not a golden artifact.
chaos/incidents/

# `make demo`'s own reduced eval run -- distinct from the committed
# top-level eval/results/*.json (the real sweep), so a stray `git add -A`
# never picks it up.
eval/results/demo/

# Reviewer front end: npm's tree and Vite's build output. `make ui` builds
# dist/ on demand, so it is a derived artifact rather than a committed one.
reviewer/web/node_modules/
reviewer/web/dist/
reviewer/web/*.tsbuildinfo

# assay audit writes report.json into the run directory it audits, and
# `assay contract compile` writes <ratecard>.contract.json beside its input.
# Both are derived from the committed inputs; regenerate rather than commit.
runs/**/report.json
runs/**/*.contract.json

# Landing page: npm's tree and Vite's build output, same position as
# reviewer/web above. site/src/data/audit.json is NOT ignored -- the page
# is static and has to ship the numbers it quotes.
site/node_modules/
site/dist/
site/*.tsbuildinfo

# Vercel's local link/build state for site/.
site/.vercel/

# Local Claude Code configuration -- agent definitions, skills and hook
# settings for this machine's editor setup. Development tooling, not part
# of the engine; kept on disk, out of the repository.
.claude/
