.env
.env.local
__pycache__/
*.py[cod]
venv/
.venv/
conda-env/
.pytest_cache/
.coverage
.vscode/

# datagen output is deterministic (same seed -> byte-identical) and
# regenerable via `python -m datagen.cli --profile ... --seed ...`, so
# ad-hoc runs aren't committed. The one canonical realistic-profile demo
# run is force-added past this ignore -- see DECISIONS.md.
runs/

# store/'s default checkpoint/journal database -- local runtime state,
# regenerated fresh (ASSAY_STORE_PATH overrides this in every test).
.assay/

# chaos/incident.py's structured incident log -- regenerated by every
# `make chaos` run, not a golden artifact.
chaos/incidents/

# `make demo`'s own reduced eval run -- distinct from the committed
# top-level eval/results/*.json (the real sweep), so a stray `git add -A`
# never picks it up.
eval/results/demo/